generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// role is a plain string: "homeowner" | "homewatcher"
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String?
  role          String?
  emailVerifiedAt DateTime?
  notifyEmail   Boolean  @default(true)
  timezone      String?
  createdAt     DateTime @default(now())

  authTokens       AuthToken[]
  visitsCreated    Visit[]
  homes            Home[]           @relation("HomeOwner")
  assignments      HomeAssignment[]
  reports          Report[]
  sentMessages     Message[]        @relation("MessageSender")
  receivedMessages Message[]        @relation("MessageRecipient")
}

model Home {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("HomeOwner", fields: [ownerId], references: [id])
  address   String
  nickname  String
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())

  assignments     HomeAssignment[]
  invites         HomeInvite[]
  visits          Visit[]
  checklistItems  ChecklistItem[]
  reports         Report[]
  messages        Message[]
}

model HomeAssignment {
  id            String   @id @default(cuid())
  homeId        String
  home          Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homewatcherId String
  homewatcher   User     @relation(fields: [homewatcherId], references: [id])
  status        String   @default("pending") // pending | accepted
  watcherNotes  String? // homewatcher's own visit-relevant notes for this home
  createdAt     DateTime @default(now())

  @@unique([homeId, homewatcherId])
}

model ChecklistItem {
  id     String @id @default(cuid())
  homeId String
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  label  String
  order  Int    @default(0)
}

model Report {
  id                String   @id @default(cuid())
  homeId            String
  home              Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homewatcherId     String
  homewatcher       User     @relation(fields: [homewatcherId], references: [id])
  checklistResults  String   // JSON string: { [checklistItemId]: boolean }
  status            String   @default("ok") // ok | attention | urgent
  notes             String?
  photoUrls         String   @default("[]") // JSON string array
  createdAt         DateTime @default(now())
}

model Message {
  id          String   @id @default(cuid())
  homeId      String
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  content     String
  createdAt   DateTime @default(now())
}

// One-time tokens for email verification and password reset. Only the SHA-256 hash is stored.
model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // verify_email | reset_password
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// An email invitation to a person who has no HomeWatch account yet.
model HomeInvite {
  id        String   @id @default(cuid())
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([homeId, email])
  @@index([email])
}

// A planned check-in at a home.
model Visit {
  id             String    @id @default(cuid())
  homeId         String
  home           Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  note           String?
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id])
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([homeId, scheduledFor])
  @@index([scheduledFor])
}
