generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// role is a plain string: "homeowner" | "homewatcher"
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String?
  role            String?
  emailVerifiedAt DateTime?
  notifyEmail     Boolean   @default(true)
  timezone        String?
  createdAt       DateTime  @default(now())

  authTokens           AuthToken[]
  visitsCreated        Visit[]
  homes                Home[]           @relation("HomeOwner")
  companyMembership    CompanyMember?
  assignedProperties   Home[]           @relation("HomeAssignedEmployee")
  clientRecords        Client[]
  invitationsSent      Invitation[]     @relation("InvitationsSent")
  inspectionsPerformed Inspection[]     @relation("InspectionsPerformed")
  notifications        Notification[]
  assignments          HomeAssignment[]
  reports              Report[]
  sentMessages         Message[]        @relation("MessageSender")
  receivedMessages     Message[]        @relation("MessageRecipient")
}

// A property. Independent homeowners own one directly (ownerId). A company-managed property
// also has companyId + clientId; its ownerId stays null until the client has an account.
model Home {
  id        String   @id @default(cuid())
  ownerId   String?
  owner     User?    @relation("HomeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  address   String // one-line full address (street, city, state zip) shown throughout the app
  nickname  String
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())

  // Company-managed structured address (all null for independent homes).
  street    String?
  city      String?
  state     String?
  zip       String?
  latitude  Float?
  longitude Float?

  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId           String?
  client             Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedEmployeeId String?
  assignedEmployee   User?    @relation("HomeAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  assignments    HomeAssignment[]
  invites        HomeInvite[]
  visits         Visit[]
  checklistItems ChecklistItem[]
  reports        Report[]
  inspections    Inspection[]
  messages       Message[]

  @@index([companyId])
  @@index([clientId])
  @@index([assignedEmployeeId])
}

model HomeAssignment {
  id            String   @id @default(cuid())
  homeId        String
  home          Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homewatcherId String
  homewatcher   User     @relation(fields: [homewatcherId], references: [id])
  status        String   @default("pending") // pending | accepted
  watcherNotes  String? // homewatcher's own visit-relevant notes for this home
  createdAt     DateTime @default(now())

  @@unique([homeId, homewatcherId])
}

model ChecklistItem {
  id     String @id @default(cuid())
  homeId String
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  label  String
  order  Int    @default(0)
}

model Report {
  id               String   @id @default(cuid())
  homeId           String
  home             Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homewatcherId    String
  homewatcher      User     @relation(fields: [homewatcherId], references: [id])
  checklistResults String // JSON string: { [checklistItemId]: boolean }
  status           String   @default("ok") // ok | attention | urgent
  notes            String?
  photoUrls        String   @default("[]") // JSON string array
  createdAt        DateTime @default(now())
}

model Message {
  id          String   @id @default(cuid())
  homeId      String
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  content     String
  createdAt   DateTime @default(now())
}

// One-time tokens for email verification and password reset. Only the SHA-256 hash is stored.
model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // verify_email | reset_password
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// An email invitation to a person who has no HomeWatch account yet.
model HomeInvite {
  id        String   @id @default(cuid())
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([homeId, email])
  @@index([email])
}

// A planned check-in at a home.
model Visit {
  id             String    @id @default(cuid())
  homeId         String
  home           Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  note           String?
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id])
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([homeId, scheduledFor])
  @@index([scheduledFor])
}

// A home-watch company: the tenant that owns clients, properties, and (later) inspections.
model Company {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  website     String?
  serviceArea String?
  address     String?
  logoUrl     String?
  brandColor  String? // #rrggbb
  createdAt   DateTime @default(now())

  members     CompanyMember[]
  clients     Client[]
  homes       Home[]
  invitations Invitation[]
  inspections Inspection[]
}

// Staff of a company. One company per user for now. role: admin | employee
model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("employee")
  createdAt DateTime @default(now())

  @@index([companyId])
}

// A homeowner the company serves. userId is set once they have a linked account.
model Client {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String? // stored lowercase
  phone     String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  homes       Home[]
  invitations Invitation[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([userId])
}

// An emailed invitation to join a company. kind "client" links the homeowner account that accepts
// it to the Client record and that client's properties; kind "employee" adds the account to the
// company's team with the given role. Only the SHA-256 hash of the token is stored, and only an
// account with the invited (verified) email address can accept it.
model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String    @default("client") // client | employee
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email       String // lowercase
  role        String? // employee invitations: admin | employee
  tokenHash   String    @unique
  invitedById String?
  invitedBy   User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId])
  @@index([email])
}

// A home check of a company property. It's created as a draft when someone taps Start Home
// Check, saved item by item as they go (so it can be resumed), and becomes visible to the
// homeowner once submitted.
model Inspection {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeId      String
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  inspectorId String?
  inspector   User?     @relation("InspectionsPerformed", fields: [inspectorId], references: [id], onDelete: SetNull)
  status      String    @default("draft") // draft | submitted
  summary     String?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  items InspectionItem[]
  media InspectionMedia[]

  @@index([homeId, status])
  @@index([companyId, submittedAt])
}

// One checklist line, copied from the template when the check starts so later template changes
// never rewrite history.
model InspectionItem {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  key          String // template key, e.g. "roof"
  label        String
  position     Int
  status       String? // good | needs_attention | repair_needed | not_checked; null until marked
  note         String?
  readingUnit  String? // set for items that take a reading, e.g. "°F"
  reading      Float?

  media InspectionMedia[]

  @@unique([inspectionId, key])
}

// A photo or video in the private media bucket. Only the object path is stored; viewers get
// short-lived signed URLs after a permission check.
model InspectionMedia {
  id           String          @id @default(cuid())
  inspectionId String
  inspection   Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       String?
  item         InspectionItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind         String // photo | video
  path         String          @unique
  contentType  String
  size         Int
  createdAt    DateTime        @default(now())

  @@index([inspectionId])
  @@index([itemId])
}

// In-app notifications. Email goes out alongside when the user allows it; push can later be
// another delivery channel for the same rows.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. inspection_submitted
  title     String
  body      String?
  link      String // in-app path to open
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
