generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// role is a plain string: "homeowner" | "homewatcher"
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String?
  role            String?
  emailVerifiedAt DateTime?
  notifyEmail     Boolean   @default(true)
  timezone        String?
  createdAt       DateTime  @default(now())

  authTokens         AuthToken[]
  visitsCreated      Visit[]
  homes              Home[]           @relation("HomeOwner")
  companyMembership  CompanyMember?
  assignedProperties Home[]           @relation("HomeAssignedEmployee")
  clientRecords      Client[]
  invitationsSent    Invitation[]     @relation("InvitationsSent")
  assignments        HomeAssignment[]
  reports            Report[]
  sentMessages       Message[]        @relation("MessageSender")
  receivedMessages   Message[]        @relation("MessageRecipient")
}

// A property. Independent homeowners own one directly (ownerId). A company-managed property
// also has companyId + clientId; its ownerId stays null until the client has an account.
model Home {
  id        String   @id @default(cuid())
  ownerId   String?
  owner     User?    @relation("HomeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  address   String // one-line full address (street, city, state zip) shown throughout the app
  nickname  String
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())

  // Company-managed structured address (all null for independent homes).
  street    String?
  city      String?
  state     String?
  zip       String?
  latitude  Float?
  longitude Float?

  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId           String?
  client             Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedEmployeeId String?
  assignedEmployee   User?    @relation("HomeAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  assignments    HomeAssignment[]
  invites        HomeInvite[]
  visits         Visit[]
  checklistItems ChecklistItem[]
  reports        Report[]
  messages       Message[]

  @@index([companyId])
  @@index([clientId])
  @@index([assignedEmployeeId])
}

model HomeAssignment {
  id            String   @id @default(cuid())
  homeId        String
  home          Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homewatcherId String
  homewatcher   User     @relation(fields: [homewatcherId], references: [id])
  status        String   @default("pending") // pending | accepted
  watcherNotes  String? // homewatcher's own visit-relevant notes for this home
  createdAt     DateTime @default(now())

  @@unique([homeId, homewatcherId])
}

model ChecklistItem {
  id     String @id @default(cuid())
  homeId String
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  label  String
  order  Int    @default(0)
}

model Report {
  id               String   @id @default(cuid())
  homeId           String
  home             Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homewatcherId    String
  homewatcher      User     @relation(fields: [homewatcherId], references: [id])
  checklistResults String // JSON string: { [checklistItemId]: boolean }
  status           String   @default("ok") // ok | attention | urgent
  notes            String?
  photoUrls        String   @default("[]") // JSON string array
  createdAt        DateTime @default(now())
}

model Message {
  id          String   @id @default(cuid())
  homeId      String
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  content     String
  createdAt   DateTime @default(now())
}

// One-time tokens for email verification and password reset. Only the SHA-256 hash is stored.
model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // verify_email | reset_password
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// An email invitation to a person who has no HomeWatch account yet.
model HomeInvite {
  id        String   @id @default(cuid())
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([homeId, email])
  @@index([email])
}

// A planned check-in at a home.
model Visit {
  id             String    @id @default(cuid())
  homeId         String
  home           Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  note           String?
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id])
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([homeId, scheduledFor])
  @@index([scheduledFor])
}

// A home-watch company: the tenant that owns clients, properties, and (later) inspections.
model Company {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  website     String?
  serviceArea String?
  address     String?
  logoUrl     String?
  brandColor  String? // #rrggbb
  createdAt   DateTime @default(now())

  members     CompanyMember[]
  clients     Client[]
  homes       Home[]
  invitations Invitation[]
}

// Staff of a company. One company per user for now. role: admin | employee
model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("employee")
  createdAt DateTime @default(now())

  @@index([companyId])
}

// A homeowner the company serves. userId is set once they have a linked account.
model Client {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String? // stored lowercase
  phone     String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  homes       Home[]
  invitations Invitation[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([userId])
}

// An emailed invitation to join a company. kind "client" links the homeowner account that accepts
// it to the Client record and that client's properties. Only the SHA-256 hash of the token is
// stored, and only an account with the invited (verified) email address can accept it.
model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String    @default("client") // client (employee invitations will reuse this table)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email       String // lowercase
  tokenHash   String    @unique
  invitedById String?
  invitedBy   User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId])
  @@index([email])
}
